# Copy to .env and fill in. Never commit .env.
PORT=3001

# Notion (expenses and users)
NOTION_SECRET=
USER_TABLE_ID=
MY_DATABASE_ID=
MY_DATABASE_ID_CC=
TXN_DATABASE_ID=

# Login tokens: any long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=

# Optional: comma-separated frontend URLs allowed by CORS
ALLOWED_ORIGINS=

# Neon Postgres (ledger). Use the *pooled* connection string (host contains "-pooler").
DATABASE_URL=
